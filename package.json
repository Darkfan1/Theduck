{
  "name": "theduck-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:erp": "npm --prefix projects/mini-erp-vite run dev",
    "build:erp": "npm --prefix projects/mini-erp-vite run build",
    "build": "npm run build:erp && next build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.475.0",
    "canvas-confetti": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "typescript": "^5.7.3"
  }
}
